<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Simulador de Tiro Parabólico - Cañón Mejorado</title>
  <style>
    body {
      background: linear-gradient(to bottom, #87ceeb, #ffffff);
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 30px;
    }
    canvas {
      background: #e0f7ff;
      border: 2px solid #333;
      display: block;
      margin: 20px auto 0 auto;
    }
    input {
      margin: 0 10px 10px 10px;
      padding: 6px;
      width: 80px;
    }
    button {
      padding: 10px 20px;
      background: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    #resultados {
      max-width: 500px;
      margin: 20px auto 0 auto;
      background: #f0f8ff;
      padding: 15px;
      border-left: 5px solid #007bff;
      font-size: 16px;
      text-align: left;
    }
  </style>
</head>
<body>

  <h1>🎯 Simulador de Tiro Parabólico con Cañón Mejorado</h1>

  <label>Velocidad (m/s): <input type="number" id="velocidad" value="50"></label>
  <label>Ángulo (°): <input type="number" id="angulo" value="45" min="0" max="90"></label>
  <label>Altura inicial (m): <input type="number" id="altura" value="0"></label>
  <br>
  <button onclick="simular()">Simular</button>

  <div id="resultados"></div>

  <canvas id="canvas" width="800" height="400"></canvas>

  <script>
    const g = 9.8; // gravedad en m/s²
    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");
    const escala = 5; // metros a píxeles
    const baseX = 80;  // posición fija del cañón en X (píxeles)
    const baseY = canvas.height - 30; // posición fija del cañón en Y (píxeles)
    const tuboLongitud = 60; // longitud del tubo del cañón en píxeles

    // Dibuja el cañón apuntando en ángulo (radianes)
    function dibujarCanon(angulo) {
      ctx.save();
      ctx.translate(baseX, baseY);
      ctx.rotate(-angulo);

      // Base del cañón (cilindro)
      ctx.fillStyle = "#555";
      ctx.beginPath();
      ctx.ellipse(0, 10, 25, 15, 0, 0, Math.PI * 2);
      ctx.fill();

      // Tubo del cañón (rectángulo con borde redondeado)
      ctx.fillStyle = "#333";
      ctx.strokeStyle = "#222";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, -8);
      ctx.lineTo(tuboLongitud, -8);
      ctx.quadraticCurveTo(tuboLongitud + 10, 0, tuboLongitud, 8);
      ctx.lineTo(0, 8);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Detalle del tubo (líneas)
      ctx.strokeStyle = "#444";
      for (let i = 10; i < tuboLongitud; i += 15) {
        ctx.beginPath();
        ctx.moveTo(i, -8);
        ctx.lineTo(i, 8);
        ctx.stroke();
      }

      ctx.restore();
    }

    // Dibuja el proyectil (bola roja con sombra) en píxeles
    function dibujarProyectil(x, y) {
      ctx.beginPath();
      let grad = ctx.createRadialGradient(x - 3, y - 3, 2, x, y, 7);
      grad.addColorStop(0, "#ff6666");
      grad.addColorStop(1, "#b20000");
      ctx.fillStyle = grad;
      ctx.shadowColor = "rgba(0,0,0,0.3)";
      ctx.shadowBlur = 4;
      ctx.shadowOffsetX = 2;
      ctx.shadowOffsetY = 2;
      ctx.arc(x, y, 7, 0, 2 * Math.PI);
      ctx.fill();
      ctx.shadowBlur = 0; // reset shadow
      ctx.strokeStyle = "#660000";
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    function simular() {
      const v0 = parseFloat(document.getElementById("velocidad").value);
      let ang = parseFloat(document.getElementById("angulo").value);
      if (ang < 0) ang = 0;
      if (ang > 90) ang = 90;
      ang = ang * Math.PI / 180;
      const h0 = parseFloat(document.getElementById("altura").value);

      const v0x = v0 * Math.cos(ang);
      const v0y = v0 * Math.sin(ang);

      // Tiempo total de vuelo (solo subida y bajada hasta suelo)
      const tVuelo = (v0y + Math.sqrt(v0y * v0y + 2 * g * h0)) / g;

      // Alcance horizontal y altura máxima
      const alcance = v0x * tVuelo;
      const alturaMax = h0 + (v0y * v0y) / (2 * g);

      // Mostrar resultado resumido
      document.getElementById("resultados").innerHTML = `
        <strong>Procedimiento resumido:</strong><br>
        Tiempo de vuelo: t = (v₀ᵧ + √(v₀ᵧ² + 2gh₀)) / g = ${tVuelo.toFixed(2)} s<br>
        Alcance horizontal: x = v₀ₓ · t = ${alcance.toFixed(2)} m<br>
        Altura máxima: y = h₀ + (v₀ᵧ²) / (2g) = ${alturaMax.toFixed(2)} m
      `;

      let tiempo = 0;
      const intervalo = 20;

      const anim = setInterval(() => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Dibuja el cañón en su ángulo actual
        dibujarCanon(ang);

        // Posición del proyectil en metros:
        // Para que salga desde la boca del cañón, sumamos tuboLongitud a la base (en dirección del ángulo)
        const xProyectil = v0x * tiempo + (tuboLongitud / escala) * Math.cos(ang);
        const yProyectil = h0 + v0y * tiempo - 0.5 * g * tiempo * tiempo + (tuboLongitud / escala) * Math.sin(ang);

        // Convertir metros a píxeles y ajustar eje y
        const px = baseX + xProyectil * escala;
        const py = canvas.height - yProyectil * escala;

        dibujarProyectil(px, py);

        tiempo += intervalo / 1000;
        if (py > canvas.height || tiempo > tVuelo) {
          clearInterval(anim);
        }
      }, intervalo);
    }
  </script>

</body>
</html>
